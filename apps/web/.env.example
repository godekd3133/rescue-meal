# demo keeps the deterministic fixture UI. production fails closed when the API is missing or not HTTPS.
VITE_DEPLOYMENT_MODE=demo
# Optional public release label used to group privacy-safe client error events.
VITE_APP_VERSION=web-local
# Required when VITE_DEPLOYMENT_MODE=production.
VITE_API_BASE_URL=http://127.0.0.1:8000
# Public VAPID key only. Never put a VAPID private key in the frontend env.
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=
