{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "playwright test",
    "test:native": "playwright test --config=playwright.native.config.ts",
    "test:connected": "playwright test --config=playwright.connected.config.ts",
    "test:mutation-readback": "node --experimental-strip-types --test tests/mutation-readback.test.mjs",
    "test:optimistic-mutation": "node --experimental-strip-types --test tests/optimistic-mutation.test.mjs",
    "test:storage-mutation-recovery": "node --experimental-strip-types --test tests/storage-mutation-recovery.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:service-worker": "node --test tests/service-worker.test.mjs",
    "test:workspace-sync": "node --experimental-strip-types --test tests/workspace-sync.test.mjs",
    "test:release-manifest": "node --test tests/release-manifest.test.mjs",
    "release:manifest": "node scripts/create-release-manifest.mjs",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "prebuild": "npm run check:runtime",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@use-gesture/react": "10.3.1",
    "@zxing/browser": "0.1.5",
    "@zxing/library": "0.21.3",
    "motion": "12.42.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
