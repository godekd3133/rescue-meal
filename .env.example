POSTGRES_DB=rescue_meal
POSTGRES_USER=rescue_meal
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_PORT=5432
API_PORT=8000
OCR_WORKER_PORT=8002
# Optional guest workspace authentication. Set both in production.
RESCUE_MEAL_AUTH_SECRET=change-me-in-secret-manager
RESCUE_MEAL_AUTH_REQUIRED=false
# Optional Grocy companion integration. Both URL and API key are required.
GROCY_BASE_URL=http://grocy:9283
GROCY_API_KEY=change-me-in-secret-manager
GROCY_TIMEOUT_SECONDS=5
# When set, the API chooses PostgresStore instead of SQLite/in-memory.
RESCUE_MEAL_DATABASE_URL=postgresql://rescue_meal:change-me-in-local-env@127.0.0.1:5432/rescue_meal
# Optional when running the API outside Compose.
RESCUE_MEAL_OCR_URL=http://127.0.0.1:8002
# Optional comma-separated browser origins for a separately hosted frontend.
RESCUE_MEAL_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
