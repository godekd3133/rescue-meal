POSTGRES_DB=rescue_meal
POSTGRES_USER=rescue_meal
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_PORT=5432
API_PORT=8000
OCR_WORKER_PORT=8002
# Explicit configuration profile. Keep preview for local demo; run the
# production preflight with production secrets before deployment.
RESCUE_MEAL_ENVIRONMENT=preview
# PostgreSQL capacity is checked in production. PROCESS_COUNT must include the
# old and new API processes that overlap during a rolling deployment.
RESCUE_MEAL_POSTGRES_PROCESS_COUNT=1
RESCUE_MEAL_POSTGRES_RESERVED_CONNECTIONS=10
RESCUE_MEAL_POSTGRES_MAX_CONNECTIONS=
# Optional guest workspace authentication. Set both in production.
RESCUE_MEAL_AUTH_SECRET=change-me-in-secret-manager
RESCUE_MEAL_AUTH_REQUIRED=false
RESCUE_MEAL_ACCESS_LOG=false
# Standard Bearer secret for the process-local Prometheus scrape surface.
# Keep it server-side; production preflight requires a strong value.
RESCUE_MEAL_OBSERVABILITY_TOKEN=
# Privacy-safe frontend render errors are emitted as structured logs by default.
RESCUE_MEAL_CLIENT_ERROR_LOG=true
RESCUE_MEAL_CLIENT_ERROR_RATE_LIMIT_MAX_REQUESTS=30
RESCUE_MEAL_CLIENT_ERROR_RATE_LIMIT_WINDOW_SECONDS=60
# Optional account password reset delivery. The provider token stays server-side.
RESCUE_MEAL_PASSWORD_RESET_BASE_URL=
RESCUE_MEAL_EMAIL_PROVIDER_URL=
RESCUE_MEAL_EMAIL_PROVIDER_TOKEN=
RESCUE_MEAL_EMAIL_TIMEOUT_SECONDS=8
RESCUE_MEAL_EMAIL_MAX_ATTEMPTS=2
RESCUE_MEAL_EMAIL_RETRY_BACKOFF_SECONDS=0.15
# Optional Web Push delivery. Keep the private key and worker token server-side.
RESCUE_MEAL_VAPID_PRIVATE_KEY=
RESCUE_MEAL_VAPID_SUBJECT=mailto:ops@example.com
RESCUE_MEAL_PUSH_TIMEOUT_SECONDS=8
RESCUE_MEAL_PUSH_TTL_SECONDS=600
RESCUE_MEAL_PUSH_MAX_ATTEMPTS=3
RESCUE_MEAL_NOTIFICATION_WORKER_TOKEN=
RESCUE_MEAL_NOTIFICATION_WORKSPACE_IDS=demo
RESCUE_MEAL_NOTIFICATION_WORKER_ID=
RESCUE_MEAL_NOTIFICATION_WORKER_INTERVAL_SECONDS=30
RESCUE_MEAL_NOTIFICATION_WORKER_LEASE_SECONDS=120
RESCUE_MEAL_NOTIFICATION_STALE_AFTER_SECONDS=900
RESCUE_MEAL_NOTIFICATION_PROCESS_LIMIT=20
# Optional barcode product enrichment. Keep disabled until provider terms and
# the Korean public-data key are configured. Product lookup never creates a
# package-level expiry date from these sources.
RESCUE_MEAL_ENABLE_EXTERNAL_LOOKUPS=false
RESCUE_MEAL_PRODUCT_LOOKUP_TIMEOUT_SECONDS=4
RESCUE_MEAL_PRODUCT_CACHE_TTL_SECONDS=604800
RESCUE_MEAL_PRODUCT_NEGATIVE_CACHE_TTL_SECONDS=900
RESCUE_MEAL_PRODUCT_FAILURE_CACHE_TTL_SECONDS=60
RESCUE_MEAL_PRODUCT_CACHE_MAX_ENTRIES=2000
RESCUE_MEAL_PRODUCT_CACHE_NAMESPACE=product-master-v3
RESCUE_MEAL_PROVIDER_RATE_LIMIT_MAX_REQUESTS=10
RESCUE_MEAL_PROVIDER_RATE_LIMIT_WINDOW_SECONDS=60
RESCUE_MEAL_PRODUCT_SINGLE_FLIGHT_LEASE_SECONDS=45
RESCUE_MEAL_PRODUCT_SINGLE_FLIGHT_WAIT_SECONDS=5
RESCUE_MEAL_PRODUCT_NAME_CACHE_TTL_SECONDS=86400
RESCUE_MEAL_PRODUCT_NAME_CACHE_NAMESPACE=product-name-v1
RESCUE_MEAL_PRODUCT_NAME_NEGATIVE_CACHE_TTL_SECONDS=600
RESCUE_MEAL_PRODUCT_NAME_FAILURE_CACHE_TTL_SECONDS=60
RESCUE_MEAL_PRODUCT_NAME_CACHE_MAX_ENTRIES=1000
RESCUE_MEAL_PRODUCT_ENRICHMENT_WORKER_TOKEN=
RESCUE_MEAL_PRODUCT_ENRICHMENT_WORKSPACE_IDS=demo
RESCUE_MEAL_PRODUCT_ENRICHMENT_WORKER_ID=
RESCUE_MEAL_PRODUCT_ENRICHMENT_WORKER_INTERVAL_SECONDS=30
RESCUE_MEAL_PRODUCT_ENRICHMENT_WORKER_LEASE_SECONDS=120
RESCUE_MEAL_PRODUCT_ENRICHMENT_STALE_AFTER_SECONDS=900
RESCUE_MEAL_PRODUCT_ENRICHMENT_PROCESS_LIMIT=5
RESCUE_MEAL_PRODUCT_ENRICHMENT_MAX_ATTEMPTS=3
RESCUE_MEAL_OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
RESCUE_MEAL_OPEN_FOOD_FACTS_API_VERSION=v3.6
RESCUE_MEAL_OPEN_FOOD_FACTS_USER_AGENT=RescueMeal/0.1 (contact@example.com)
RESCUE_MEAL_MFDS_BASE_URL=https://openapi.foodsafetykorea.go.kr
MFDS_API_KEY=
# Production auth endpoints use a shared SQLite/PostgreSQL event limiter when
# a persistent auth store is configured; in-memory mode remains process-local.
RESCUE_MEAL_AUTH_RATE_LIMIT_ENABLED=
RESCUE_MEAL_AUTH_RATE_LIMIT_MAX_REQUESTS=20
RESCUE_MEAL_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
RESCUE_MEAL_EXPORT_RATE_LIMIT_ENABLED=true
RESCUE_MEAL_EXPORT_RATE_LIMIT_MAX_REQUESTS=6
RESCUE_MEAL_EXPORT_RATE_LIMIT_WINDOW_SECONDS=3600
# Optional Grocy companion integration. Both URL and API key are required.
GROCY_BASE_URL=http://grocy:9283
GROCY_API_KEY=change-me-in-secret-manager
GROCY_TIMEOUT_SECONDS=5
# Optional companion worker. Set account/guest workspace IDs explicitly when
# running infra/docker-compose.yml so the worker never guesses tenant scope.
RESCUE_MEAL_GROCY_WORKSPACE_IDS=demo
RESCUE_MEAL_GROCY_WORKER_ID=
RESCUE_MEAL_GROCY_WORKER_INTERVAL_SECONDS=30
RESCUE_MEAL_GROCY_WORKER_LEASE_SECONDS=120
RESCUE_MEAL_GROCY_STALE_AFTER_SECONDS=900
RESCUE_MEAL_GROCY_PROCESS_LIMIT=20
# Service-to-service token used only by the separate worker to call the API
# tick endpoint. Keep it in a secret manager in real deployments.
RESCUE_MEAL_API_BASE_URL=http://127.0.0.1:8000
RESCUE_MEAL_GROCY_WORKER_TOKEN=
# Optional 식품안전나라 COOKRCP01 recipe import. Imported rows remain review drafts.
FOODSAFETY_COOKRCP_API_KEY=
FOODSAFETY_COOKRCP_BASE_URL=https://openapi.foodsafetykorea.go.kr
FOODSAFETY_COOKRCP_TIMEOUT_SECONDS=8
# Legacy local operator token; leave empty in production and use recipe_admin accounts.
# Production preflight, /ready, and the runtime review guard reject any non-empty value.
# Never expose this value to the browser or commit it to the repository.
RESCUE_MEAL_RECIPE_REVIEW_TOKEN=
# Comma-separated bootstrap emails that receive the recipe_admin role at registration.
# Keep this allowlist server-side; normal users stay role=user.
RESCUE_MEAL_RECIPE_ADMIN_EMAILS=
# Optional comma-separated publisher emails. Empty preserves the legacy rule that
# every recipe_admin may approve/reject; when set, other admins remain reviewers only.
RESCUE_MEAL_RECIPE_PUBLISHER_EMAILS=
# Explicit review ownership lease. Expired claims can be recovered by another admin.
RESCUE_MEAL_RECIPE_REVIEW_CLAIM_TTL_SECONDS=3600
# When set, the API chooses PostgresStore instead of SQLite/in-memory.
RESCUE_MEAL_DATABASE_URL=postgresql://rescue_meal:change-me-in-local-env@127.0.0.1:5432/rescue_meal
RESCUE_MEAL_INVENTORY_MODE=projection
# PostgreSQL backup/restore client: auto uses host clients when the complete
# toolchain exists, otherwise it falls back to Docker. Pin an approved image
# digest for production operations; the major-version guard remains enabled.
RESCUE_MEAL_POSTGRES_CLIENT_MODE=auto
RESCUE_MEAL_POSTGRES_CLIENT_IMAGE=postgres:16-alpine
RESCUE_MEAL_POSTGRES_CLIENT_DOCKER_NETWORK=
# Runtime PostgreSQL DDL is disabled by default. Apply infra/postgres/migrate.sh
# first; set true only for an explicitly isolated compatibility/dev database.
RESCUE_MEAL_ALLOW_RUNTIME_SCHEMA_DDL=false
# Maximum idle durable workspace stores retained per API process.
RESCUE_MEAL_WORKSPACE_STORE_CACHE_SIZE=16
# Operation-scoped PostgreSQL pool. These cap workspace DB checkouts per API
# process; base/auth/shared catalog connections remain separately owned.
RESCUE_MEAL_POSTGRES_POOL_MIN_SIZE=1
RESCUE_MEAL_POSTGRES_POOL_MAX_SIZE=8
RESCUE_MEAL_POSTGRES_POOL_TIMEOUT_SECONDS=5
RESCUE_MEAL_POSTGRES_POOL_MAX_WAITING=64
RESCUE_MEAL_POSTGRES_POOL_MAX_IDLE_SECONDS=300
RESCUE_MEAL_POSTGRES_POOL_MAX_LIFETIME_SECONDS=1800
RESCUE_MEAL_POSTGRES_POOL_RECONNECT_TIMEOUT_SECONDS=30
RESCUE_MEAL_POSTGRES_POOL_CLOSE_TIMEOUT_SECONDS=5
# Direct base/auth/shared PostgreSQL owners retry connection establishment
# after a dropped socket. Failed queries and commits are never replayed.
RESCUE_MEAL_POSTGRES_DIRECT_RECONNECT_TIMEOUT_SECONDS=5
# Optional when running the API outside Compose.
RESCUE_MEAL_OCR_URL=http://127.0.0.1:8002
# Optional local structured-output inference. Keep rules in production until
# the selected model passes a domain benchmark; Ollama never supplies a
# printed expiry date or safety verdict.
RESCUE_MEAL_INFERENCE_PROVIDER=rules
RESCUE_MEAL_OLLAMA_BASE_URL=http://127.0.0.1:11434
RESCUE_MEAL_OLLAMA_MODEL=gemma4
RESCUE_MEAL_OLLAMA_TIMEOUT_SECONDS=8
# Optional comma-separated browser origins for a separately hosted frontend.
RESCUE_MEAL_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
